# Copy this file to storefront/.env and paste your keys.
# Never commit .env. Restart `python storefront/serve.py` after editing.

# Stripe secret key (sk_test_... for test mode, sk_live_... when you go live)
STRIPE_SECRET_KEY=

# Optional: publishable key is not required for Checkout Sessions
STRIPE_PUBLISHABLE_KEY=

# Resend API key (https://resend.com) for the free-pack email
RESEND_API_KEY=

# Must be a domain you verified in Resend
EMAIL_FROM=TI-84 Python <noreply@example.com>

# Public URL Stripe redirects back to after payment
PUBLIC_BASE=http://127.0.0.1:8765
